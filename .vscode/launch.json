{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run OTA Server GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "QT_AUTO_SCREEN_SCALE_FACTOR": "1"
            }
        }
    ]
}